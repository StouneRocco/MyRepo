MONGODB_URI=mongodb://127.0.0.1:27017/promptathlon
# Generate a unique secret with at least 32 characters; never use this example value.
# Example: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_TIMEZONE=Europe/Paris

# Configure Brevo to send decision emails. Until set, decisions are saved but emails fail visibly.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JDA — Accréditations presse
